# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build ----------------------------------------------------
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/

# --- Testing / tooling caches ---------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Simulation output ----------------------------------------------------
